{
  "name": "inventory-platform",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace frontend dev --host 0.0.0.0 --port 5173\" \"yarn workspace backend start:dev\"",
    "build": "yarn workspaces run build",
    "lint": "yarn workspaces run lint",
    "prisma:gen": "prisma generate",
    "prisma:mig": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.19.1"
  }
}
